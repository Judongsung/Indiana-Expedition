<Project>
  <PropertyGroup>
    <IndianaExpeditionVersion>0.3.0</IndianaExpeditionVersion>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <RestorePackagesPath>$(MSBuildThisFileDirectory).packages</RestorePackagesPath>
    <TargetFrameworkRootPath>$(MSBuildThisFileDirectory).packages\microsoft.netframework.referenceassemblies.net48\1.0.3\build\</TargetFrameworkRootPath>
  </PropertyGroup>
</Project>
